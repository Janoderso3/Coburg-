; Bau-Sandbox (Godot 4.7, C#)
config_version=5

[application]

config/name="Bau-Sandbox"
config/description="Realistischer Baustellen-Simulator"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/size/mode=2
window/handheld/orientation=4

[dotnet]

project/assembly_name="BauSandbox"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=100
common/max_physics_steps_per_frame=6

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssil/quality=2
environment/glow/upscale_mode=1
textures/default_filters/anisotropic_filtering_level=4
